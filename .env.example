# === Telegram (обязательно) ===
# Получить: https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Номер телефона вашего аккаунта в международном формате
PHONE=+79991234567
# Файл сессии (создастся при первом входе). НИКОМУ НЕ ПЕРЕДАВАЙТЕ!
SESSION_FILE=userbot.session

# === Белый список чатов (обязательно) ===
# Через запятую: @username или числовой id. ИИ отвечает ТОЛЬКО здесь.
# Пример: ALLOWED_CHATS=@ivan_buyer, @shop_chat, -1001234567890
ALLOWED_CHATS=

# === ИИ-провайдер ===
# claude | mistral
PROVIDER=claude

# --- Claude (ключ: https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (low — быстрее и дешевле)
CLAUDE_EFFORT=low
USE_FALLBACKS=true

# --- Mistral (ключ: https://console.mistral.ai/api-keys) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.7

# === Память и лимиты ===
HISTORY_LIMIT=20
MAX_TOKENS=4096

# === Предохранители ===
# Пауза перед ответом, секунды (имитация человеческой реакции)
MIN_REPLY_DELAY=3

# === Отладка ===
# 1 — отвечать эхом без ИИ (проверка входа и фильтров)
# ECHO_MODE=1
